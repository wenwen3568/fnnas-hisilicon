#
# Hi3798MV100 Kernel Configuration for fnOS
# Based on mainline Linux 6.6+ with Hisilicon support
# Requires Hi3798MV100 patches (David Yang v7)
#

# Architecture
CONFIG_ARM64=y
CONFIG_ARCH_HISI=y
CONFIG_ARCH_HI3798=y
CONFIG_ARCH_HI3798MV100=y

# Platform selection
CONFIG_HISILICON=y
CONFIG_HISI_SAS=y
CONFIG_HISI_SAS_PCI=y

# CPU
CONFIG_CPU_CORTEX_A7=y
CONFIG_SMP=y
CONFIG_NR_CPUS=4
CONFIG_HOTPLUG_CPU=y
CONFIG_ARM64_CRYPTO=y

# Memory
CONFIG_ARM64_64K_PAGES=y
CONFIG_ARM64_VA_BITS_48=y
CONFIG_ARM64_VA_BITS=48
CONFIG_ARM64_PA_BITS_48=y
CONFIG_MEMORY_HOTPLUG=y
CONFIG_MEMORY_HOTREMOVE=y

# Kernel features
CONFIG_PREEMPT=y
CONFIG_PREEMPT_VOLUNTARY=y
CONFIG_KEXEC=y
CONFIG_KEXEC_FILE=y
CONFIG_CRASH_DUMP=y
CONFIG_PROC_VMCORE=y

# Boot options
CONFIG_CMDLINE="console=ttyAMA0,115200n8 earlycon=pl011,0xf8008b000000 rootwait"
CONFIG_CMDLINE_FORCE=y

# Power management
CONFIG_PM=y
CONFIG_PM_SLEEP=y
CONFIG_CPU_PM=y
CONFIG_ARCH_SUSPEND_POSSIBLE=y
CONFIG_ARM_CPU_SUSPEND=y
CONFIG_ARM_PSCI_FW=y
CONFIG_ARM_PSCI_CPUIDLE=y
CONFIG_CPU_IDLE=y
CONFIG_CPU_IDLE_MULTIPLE_DRIVERS=y
CONFIG_CPU_IDLE_GOV_MENU=y
CONFIG_ARM_CPUIDLE=y

# ACPI (for UEFI boot)
# CONFIG_ACPI is not set
# CONFIG_ACPI_GENERIC_GSI is not set
# CONFIG_ACPI_CCA_REQUIRED is not set
# CONFIG_ACPI_SPCR_TABLE is not set
# CONFIG_ACPI_IORT is not set

# Device tree
CONFIG_USE_OF=y
CONFIG_OF_ADDRESS=y
CONFIG_OF_IRQ=y
CONFIG_OF_NET=y
CONFIG_OF_MDIO=y
CONFIG_OF_PCI=y
CONFIG_OF_PCI_IRQ=y
CONFIG_OF_RESERVED_MEM=y

# Bus support
CONFIG_PCI=y
CONFIG_PCI_HOST_GENERIC=y
CONFIG_PCI_HOST_THUNDER_PEM=y
CONFIG_PCI_HOST_THUNDER_ECAM=y
CONFIG_PCIE_HISI=y
CONFIG_PCIE_HISI_STB=y

# Clock framework - CRITICAL: Enable Hi3798 clock driver for MV100 patches
CONFIG_COMMON_CLK=y
CONFIG_CLK_HISI=y
CONFIG_CLK_HI3798=y
CONFIG_CLK_HI6220=y
CONFIG_CLK_HI3660=y
CONFIG_CLK_HI3670=y

# Reset controller
CONFIG_RESET_CONTROLLER=y
CONFIG_RESET_HISI=y
CONFIG_RESET_HI3798MV100=y

# Pin control
CONFIG_PINCTRL=y
CONFIG_PINCTRL_HISI=y
CONFIG_PINCTRL_HI3798MV100=y

# GPIO
CONFIG_GPIOLIB=y
CONFIG_GPIO_SYSFS=y
CONFIG_GPIO_HISI=y

# Interrupt controller
CONFIG_GIC=y
CONFIG_GIC_V3=y
CONFIG_GIC_V3_ITS=y

# Timer
CONFIG_ARM_ARCH_TIMER=y
CONFIG_ARM_ARCH_TIMER_EVTSTREAM=y

# Serial
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_NR_UARTS=4
CONFIG_SERIAL_8250_RUNTIME_UARTS=4
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y

# I2C
CONFIG_I2C=y
CONFIG_I2C_CHARDEV=y
CONFIG_I2C_HISI=y

# SPI
CONFIG_SPI=y
CONFIG_SPI_HISI=y

# MMC/SD/eMMC
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_BLOCK_MINORS=8
CONFIG_MMC_BLOCK_BOUNCE=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PLTFM=y
CONFIG_MMC_DW=y
CONFIG_MMC_DW_PLTFM=y
CONFIG_MMC_DW_HISI=y
CONFIG_MMC_DW_HI3798MV100=y

# Network
CONFIG_NET=y
CONFIG_NET_VENDOR_HISILICON=y
CONFIG_HISI_GMAC=y
CONFIG_HISI_GMAC_V2=y
CONFIG_HISI_GMAC_HI3798MV100=y

# USB
CONFIG_USB=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_EHCI_ROOT_HUB_TT=y
CONFIG_USB_EHCI_TT_NEWSCHED=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_OHCI_HCD_PLATFORM=y
CONFIG_USB_HISI_EHCI=y
CONFIG_USB_HISI_OHCI=y
CONFIG_USB_PHY=y
CONFIG_USB_HISI_PHY=y
CONFIG_PHY_HISI_INNO_USB2=y
CONFIG_PHY_HI3798MV100_USB2=y

# Watchdog
CONFIG_WATCHDOG=y
CONFIG_WATCHDOG_CORE=y
CONFIG_HISI_WDT=y

# RTC
CONFIG_RTC_LIB=y
CONFIG_RTC_CLASS=y
CONFIG_RTC_HISI=y

# Thermal
CONFIG_THERMAL=y
CONFIG_THERMAL_HWMON=y
CONFIG_THERMAL_OF=y
CONFIG_THERMAL_DEFAULT_GOV_STEP_WISE=y
CONFIG_HISI_THERMAL=y
CONFIG_HI3798MV100_THERMAL=y

# Crypto
CONFIG_CRYPTO=y
CONFIG_CRYPTO_HISI=y
CONFIG_CRYPTO_HI3798MV100=y
CONFIG_CRYPTO_AES_ARM64=y
CONFIG_CRYPTO_SHA1_ARM64_CE=y
CONFIG_CRYPTO_SHA256_ARM64=y
CONFIG_CRYPTO_SHA512_ARM64=y
CONFIG_CRYPTO_GHASH_ARM64_CE=y
CONFIG_CRYPTO_CRCT10DIF_ARM64_CE=y
CONFIG_CRYPTO_CHACHA20_NEON=y

# VPU/Video
CONFIG_VIDEO_HISI_VPU=y
CONFIG_VIDEO_HI3798MV100_VPU=y
CONFIG_VIDEO_H265_DECODER=y
CONFIG_VIDEO_H264_DECODER=y
CONFIG_VIDEO_VP9_DECODER=y

# GPU
CONFIG_DRM=y
CONFIG_DRM_HISI=y
CONFIG_DRM_HI3798MV100=y

# Filesystems
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_BTRFS_FS=y
CONFIG_BTRFS_FS_POSIX_ACL=y
CONFIG_F2FS_FS=y
CONFIG_F2FS_FS_POSIX_ACL=y
CONFIG_XFS_FS=y
CONFIG_OVERLAY_FS=y
CONFIG_OVERLAY_FS_REDIRECT_DIR=y
CONFIG_OVERLAY_FS_INDEX=y
CONFIG_OVERLAY_FS_METACOPY=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XATTR=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_NFS_FS=y
CONFIG_NFS_V3=y
CONFIG_NFS_V4=y
CONFIG_NFS_V4_1=y
CONFIG_NFS_V4_2=y

# Partition support
CONFIG_PARTITION_ADVANCED=y
CONFIG_EFI_PARTITION=y
CONFIG_MSDOS_PARTITION=y

# Kernel debugging
CONFIG_DEBUG_KERNEL=y
CONFIG_DEBUG_INFO=y
CONFIG_DEBUG_INFO_DWARF5=y
CONFIG_DEBUG_FS=y
CONFIG_MAGIC_SYSRQ=y
CONFIG_MAGIC_SYSRQ_DEFAULT_ENABLE=0x1
CONFIG_DEBUG_KMEMLEAK=y

# Compression
CONFIG_KERNEL_GZIP=y
CONFIG_KERNEL_XZ=y
CONFIG_KERNEL_ZSTD=y
CONFIG_RD_GZIP=y
CONFIG_RD_XZ=y
CONFIG_RD_ZSTD=y

# Module support
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_MODULE_COMPRESS_ZSTD=y
CONFIG_MODVERSIONS=y
CONFIG_MODULE_SRCVERSION_ALL=y

# Security
CONFIG_SECURITY=y
CONFIG_SECURITY_NETWORK=y
CONFIG_SECURITY_PATH=y
CONFIG_SECURITY_YAMA=y
CONFIG_DEFAULT_SECURITY_DAC=y
CONFIG_LSM="yama,loadpin,safesetid,integrity"

# Virtualization (for Docker)
CONFIG_VIRTUALIZATION=y
CONFIG_KVM=y
CONFIG_KVM_ARM_HOST=y
CONFIG_KVM_ARM_PMU=y
CONFIG_VHOST_NET=y
CONFIG_VHOST_VSOCK=y

# Containers
CONFIG_CGROUPS=y
CONFIG_CGROUP_BPF=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CGROUP_PERF=y
CONFIG_CGROUP_BPF=y
CONFIG_CGROUP_HUGETLB=y
CONFIG_CPUSETS=y
CONFIG_PROC_PID_CPUSET=y
CONFIG_CGROUP_SCHED=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_CFS_BANDWIDTH=y
CONFIG_RT_GROUP_SCHED=y
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_CGROUP_NS=y

# BPF
CONFIG_BPF=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_BPF_JIT_ALWAYS_ON=y
CONFIG_BPF_EVENTS=y
CONFIG_BPF_LSM=y
CONFIG_HAVE_EBPF_JIT=y

# Firmware
CONFIG_FIRMWARE_IN_KERNEL=y
CONFIG_EXTRA_FIRMWARE_DIR="firmware"
CONFIG_FIRMWARE_MEMMAP=y

# Sound (optional)
CONFIG_SND=y
CONFIG_SND_SOC=y
CONFIG_SND_SOC_HISI=y

# LED
CONFIG_NEW_LEDS=y
CONFIG_LEDS_CLASS=y
CONFIG_LEDS_GPIO=y
CONFIG_LEDS_TRIGGERS=y
CONFIG_LEDS_TRIGGER_HEARTBEAT=y
CONFIG_LEDS_TRIGGER_DEFAULT_ON=y
CONFIG_LEDS_TRIGGER_TRANSIENT=y

# PWM
CONFIG_PWM=y
CONFIG_PWM_HISI=y

# Hardware monitoring
CONFIG_HWMON=y
CONFIG_HWMON_VID=y

# GPIO sysfs (deprecated but needed for some tools)
CONFIG_GPIO_SYSFS=y

# ARM64 errata workarounds
CONFIG_ARM64_ERRATUM_826319=y
CONFIG_ARM64_ERRATUM_827319=y
CONFIG_ARM64_ERRATUM_824069=y
CONFIG_ARM64_ERRATUM_819472=y
CONFIG_ARM64_ERRATUM_832075=y
CONFIG_ARM64_ERRATUM_845719=y
CONFIG_ARM64_ERRATUM_843419=y
CONFIG_CAVIUM_ERRATUM_22375=y
CONFIG_CAVIUM_ERRATUM_23113=y
CONFIG_CAVIUM_ERRATUM_23154=y
CONFIG_QCOM_FALKOR_ERRATUM_1003=y
CONFIG_QCOM_FALKOR_ERRATUM_1009=y
CONFIG_QCOM_QDF2400_ERRATUM_0065=y
CONFIG_HISILICON_ERRATUM_161010101=y
CONFIG_HISILICON_ERRATUM_161600802=y
